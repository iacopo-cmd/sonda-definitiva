# /etc/minibench-net/config.env  -  MiniBench Net, sonda definitiva, PRECOMPILATO per la macchina netcup
MINIBENCH_NET_URL=https://vps-a52aed3b.vps.ovh.net:60016
# facoltativi: tutto NASCOSTO finche' non lo metti in PUBBLICI
NICK=iacopo
NICK_VISIBILE=no
# nome che compare sulla pagina (cambialo se vuoi l'hostname vero)
NOME_HOST=netcup
PROVIDER=netcup
# provider | selfhost | amico | sconosciuto
TIPO_HOSTING=provider
# dal pannello netcup (SCP): nome del piano (es. VPS 1000 G11), vCPU del piano, paese del datacenter (DE Norimberga, AT Vienna, US Manassas...)
PIANO=
VCPU_DICHIARATE=
PAESE=
CITTA=
# cosa si puo' mostrare: nome_host,provider_dich,tipo_hosting,piano,prezzo_mese,paese,citta,note,vcpu_dichiarate
PUBBLICI=nome_host,provider_dich,tipo_hosting
# intervalli: vuoto = quelli del server (check 3 min, ping 27 min, traceroute 12 ore, test 9 min)
OGNI_CHECK_MIN=
OGNI_PING_MIN=
OGNI_PERCORSI_ORE=
OGNI_TEST_MIN=
# minuti dell'ora (UTC) in cui il test CPU NON parte (es. 18-23 se un altro benchmark gira ai :20)
TEST_EVITA_MINUTI=
